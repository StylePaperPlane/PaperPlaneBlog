{
  "openapi": "3.1.0",
  "info": {"title": "PaperPlane Media API", "version": "1.0.0"},
  "servers": [{"url": "https://media.paperplane.codes"}],
  "paths": {
    "/health": {"get": {"operationId": "health", "responses": {"200": {"description": "Healthy"}}}},
    "/v1/tracks": {"get": {"operationId": "listPublicTracks", "responses": {"200": {"description": "Enabled tracks", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublicTrackList"}}}}}}},
    "/v1/playback/sessions": {"post": {"operationId": "createPlaybackSession", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatePlaybackSession"}}}}, "responses": {"200": {"description": "Session created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlaybackSessionResponse"}}}}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/v1/playback/tracks/{assetId}/key": {"post": {"operationId": "issueTrackKey", "parameters": [{"name": "assetId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, {"name": "X-Media-Fingerprint", "in": "header", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Wrapped content key", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IssuedKeyResponse"}}}}, "429": {"$ref": "#/components/responses/TooManyRequests"}}}},
    "/v1/admin/tracks": {
      "get": {"operationId": "listAdminTracks", "responses": {"200": {"description": "All tracks", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminTrackList"}}}}}},
      "post": {"operationId": "uploadTrack", "requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["archive", "title", "artist"], "properties": {"archive": {"type": "string", "format": "binary"}, "title": {"type": "string"}, "artist": {"type": "string"}, "sortOrder": {"type": "integer"}, "enabled": {"type": "boolean"}}}}}}, "responses": {"201": {"description": "Track published", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminTrackResponse"}}}}, "413": {"description": "Archive too large"}, "429": {"$ref": "#/components/responses/TooManyRequests"}}},
      "delete": {"operationId": "deleteTracks", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["ids"], "properties": {"ids": {"type": "array", "items": {"type": "integer", "format": "int64"}}}}}}}, "responses": {"200": {"description": "Tracks deleted"}}}
    },
    "/v1/admin/tracks/{id}": {"patch": {"operationId": "patchTrack", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TrackPatch"}}}}, "responses": {"200": {"description": "Track updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AdminTrackResponse"}}}}}}},
    "/assets/{sha256}.ppm": {"get": {"operationId": "getEncryptedAsset", "parameters": [{"name": "sha256", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "Range", "in": "header", "schema": {"type": "string"}}], "responses": {"200": {"description": "Full PPM1 object"}, "206": {"description": "PPM1 byte range"}}}}
  },
  "components": {"responses": {
    "TooManyRequests": {"description": "Rate limit exceeded", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
  }, "schemas": {
    "CreatePlaybackSession": {"type": "object", "required": ["fingerprintSha256", "fingerprintVersion", "devicePublicKey"], "properties": {"fingerprintSha256": {"type": "string"}, "fingerprintVersion": {"type": "integer"}, "devicePublicKey": {"type": "object", "required": ["kty", "alg", "n", "e"], "properties": {"kty": {"const": "RSA"}, "alg": {"const": "RSA-OAEP-256"}, "n": {"type": "string"}, "e": {"type": "string"}}}}},
    "PublicTrack": {"type": "object", "required": ["musicKey", "assetId", "title", "artist", "audioFormat", "plaintextSize", "chunkSize", "chunkCount", "cipherUrl"], "properties": {"musicKey": {"type": "integer", "format": "int64"}, "assetId": {"type": "string", "format": "uuid"}, "title": {"type": "string"}, "artist": {"type": "string"}, "audioFormat": {"$ref": "#/components/schemas/AudioFormat"}, "coverUrl": {"type": ["string", "null"]}, "lyricUrl": {"type": ["string", "null"]}, "plaintextSize": {"type": "integer", "format": "int64"}, "chunkSize": {"type": "integer"}, "chunkCount": {"type": "integer"}, "cipherUrl": {"type": "string"}}},
    "PublicTrackList": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/PublicTrack"}}}},
    "PlaybackSession": {"type": "object", "required": ["expiresAt"], "properties": {"expiresAt": {"type": "string", "format": "date-time"}}},
    "PlaybackSessionResponse": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/PlaybackSession"}}},
    "IssuedKey": {"type": "object", "required": ["assetId", "wrappedKey", "algorithm", "expiresAt", "plaintextSize", "chunkSize", "chunkCount", "noncePrefix", "cipherSha256", "audioFormat"], "properties": {"assetId": {"type": "string", "format": "uuid"}, "wrappedKey": {"type": "string"}, "algorithm": {"const": "RSA-OAEP-256"}, "expiresAt": {"type": "string", "format": "date-time"}, "plaintextSize": {"type": "integer", "format": "int64"}, "chunkSize": {"type": "integer"}, "chunkCount": {"type": "integer"}, "noncePrefix": {"type": "string"}, "cipherSha256": {"type": "string"}, "audioFormat": {"$ref": "#/components/schemas/AudioFormat"}}},
    "IssuedKeyResponse": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/IssuedKey"}}},
    "AdminTrack": {"type": "object", "required": ["musicKey", "assetId", "title", "artist", "audioFormat", "sortOrder", "enabled", "createdAt", "updatedAt"], "properties": {"musicKey": {"type": "integer", "format": "int64"}, "assetId": {"type": "string", "format": "uuid"}, "title": {"type": "string"}, "artist": {"type": "string"}, "audioFormat": {"$ref": "#/components/schemas/AudioFormat"}, "coverPath": {"type": ["string", "null"]}, "lyricPath": {"type": ["string", "null"]}, "sortOrder": {"type": "integer"}, "enabled": {"type": "boolean"}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}}},
    "AudioFormat": {"type": "string", "enum": ["mp3", "flac"]},
    "AdminTrackList": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/AdminTrack"}}}},
    "AdminTrackResponse": {"type": "object", "required": ["data"], "properties": {"data": {"$ref": "#/components/schemas/AdminTrack"}}},
    "TrackPatch": {"type": "object", "properties": {"title": {"type": "string"}, "artist": {"type": "string"}, "sortOrder": {"type": "integer"}, "enabled": {"type": "boolean"}}},
    "Problem": {"type": "object", "required": ["type", "title", "status", "detail"], "properties": {"type": {"type": "string", "format": "uri"}, "title": {"type": "string"}, "status": {"type": "integer"}, "detail": {"type": "string"}}}
  }}
}
